# ATLAS environment template — copy to `.env.local` for local dev.
#
# All `VITE_*` values are baked into the browser bundle at build time.
# Server-only secrets (e.g. BigQuery service account JSON) live in
# Vercel project settings and are NEVER prefixed with VITE_.

# ── Globe basemap ───────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP3D_MAP_ID=

# ── BigQuery backend for historical analytics ───────────────────────
# Points the client at `vercel dev --listen 3001` during local development.
# In production leave unset: the client calls `/api/*` on the same origin.
VITE_ATLAS_API_BASE=http://localhost:3001

# ── Server-only (set in Vercel dashboard, NOT here for prod) ────────
# Service account JSON (single-line, JSON-stringified).
# GOOGLE_CLOUD_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
# Optional guard: reject BigQuery queries whose dryRun estimate
# exceeds this many bytes. Default 500_000_000 (500 MB).
# ATLAS_MAX_SCAN_BYTES=500000000

# ── Ask Atlas chatbot (server-only, NOT VITE_ prefixed) ─────────────
# Google Gemini key, used by /api/chat. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash).
# GEMINI_MODEL=

# ── Optional data source keys ───────────────────────────────────────
# Client-side (dev / fallback). In production prefer server-only keys below.
VITE_NEWSAPI_KEY=
VITE_NEWS_API_KEY=
VITE_GNEWS_KEY=
VITE_THENEWSAPI_KEY=
VITE_YOUTUBE_API_KEY=
VITE_FIRMS_MAP_KEY=
# OpenWeatherMap — free API key (sign in → API keys):
# https://home.openweathermap.org/api_keys
# Docs: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-only news keys (Vercel — NOT VITE_ prefixed) ─────────────
# Used by /api/news-proxy so keys never ship in the browser bundle.
NEWSAPI_KEY=
GNEWS_API_KEY=
THENEWSAPI_KEY=
YOUTUBE_API_KEY=
# Optional micro-local news enrichment (lat/lng radius) when GDELT GEO is thin:
# https://apitube.io — /api/news-proxy?provider=apitube
APITUBE_KEY=
# Restrict browser news calls to proxy in local dev (optional):
# VITE_NEWS_PROXY=true
# Server-only — required for L2 feed_snapshots writes (never VITE_ prefix)
# SUPABASE_SERVICE_ROLE_KEY=

# ── Scheduled ingestion (server-only — NOT VITE_ prefixed) ────────────
# Bearer token /api/ingest requires. Generate with: openssl rand -hex 32
# Store the same value in Supabase Vault as `ingest_secret` so pg_cron can
# read it (see supabase/migrations/010_ingest_schedule.sql). With this unset
# the route returns 401 for every request.
INGEST_SECRET=
# Absolute origin pg_cron posts to. Defaults to VERCEL_URL in production.
# INGEST_BASE_URL=https://your-deployment.vercel.app

# ── Economy / indicators (server-only — NOT VITE_ prefixed) ─────────
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=
# Census ACS (free): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# BEA Regional (free): https://apps.bea.gov/API/signup/
BEA_KEY=
# Finnhub FX is intentionally not used for place Economy (global-only / 403 noise).
# FINNHUB_KEY=

# ── Phase 3 maritime (server-only — NOT VITE_ prefixed) ───────────────
# AISStream.io free tier: register at https://aisstream.io, create API key.
# Used by /api/aisstream-ships (browser cannot connect to AISStream directly).
AISSTREAM_API_KEY=

# ── Live Cameras layer (server-only — NOT VITE_ prefixed) ──────────────
# Used by /api/cameras. TfL + Caltrans work without keys; Windy needs a key
# for global coverage.
# Windy Webcams (free): https://api.windy.com/keys — pick Webcams API
# Docs / pricing: https://api.windy.com/webcams/pricing
WINDY_API_KEY=
# TfL Unified API (optional, free): https://api-portal.tfl.gov.uk/signup
TFL_APP_KEY=

# ── DoD DVIDS military public-affairs (client — worker keyed config) ───
# Free: https://api.dvidshub.net/ → register → create API application.
# Vite exposes only VITE_* keys to the browser worker.
VITE_DVIDS_API_KEY=

# ── Phase 6 stretch (server-only — NOT VITE_ prefixed) ────────────────
# Google Fact Check Tools API — free tier at Google Cloud Console.
# Used by /api/fact-check-claims for ClaimReview overlay + EventPanel lookup.
GOOGLE_FACT_CHECK_API_KEY=

# ── Contact + feedback intake (/api/contact — server-only) ────────────
# Resend API key: https://resend.com → API Keys → Create.
# Without a verified domain, Resend only delivers to the address the account
# was registered with, which is the intended inbox here.
RESEND_API_KEY=
# Inbox that receives landing-page messages, bug reports, feature requests.
CONTACT_TO_EMAIL=shreyassunke005@gmail.com
# Sender identity. Keep the shared Resend sandbox address until a domain is
# verified, then switch to e.g. "ATLAS <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=ATLAS <onboarding@resend.dev>

# ── Outbound alerts (Supabase Edge Function send-alert) ───────────────
# Deploy supabase/functions/send-alert and set in Supabase project secrets.
# Shares RESEND_API_KEY above when deployed to Supabase project secrets.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# ALERT_FROM_EMAIL=alerts@atlas-intel.app

# ── Trend Detective submission ────────────────────────────────────────
# Aircraft, ships, conflict and crypto feeds are hidden by default.
# VITE_ATLAS_SHOW_ALL_LAYERS=true
